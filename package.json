{
  "name": "verbosia-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "Verbosia — tradução com IA para sites estáticos, Astro-first, com Translation Memory e SEO de primeira classe.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "contracts:check": "pnpm --filter @verbosia/core contracts:check",
    "contracts:generate": "pnpm --filter @verbosia/core contracts:generate",
    "contracts:test": "vitest run packages/core/test/contracts",
    "evidence:add-only:check": "node ./scripts/check-evidence-add-only.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
