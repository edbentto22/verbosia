{
  "name": "@verbosia/mcp",
  "version": "0.1.0",
  "description": "Servidor MCP local e seguro para inspeção e planejamento de localização com Verbosia.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "verbosia-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm --filter @verbosia/core build && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@verbosia/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edbentto22/verbosia.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/edbentto22/verbosia#readme",
  "bugs": "https://github.com/edbentto22/verbosia/issues",
  "engines": {
    "node": ">=20.0.0"
  }
}
